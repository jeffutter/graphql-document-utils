---
source: tests/examples.rs
expression: transcript(&common_tasks())
---
$ graphql-document-utils query normalize -q query.graphql
exit: 0
stdout:
query GetUser($filter: SearchFilter, $first: Int, $id: ID!) {
  company {
    employees(first: $first) {
      name
    }
  }
  search(filter: $filter) {
    __typename
    ... on Company {
      name
    }
    ... on User {
      email
    }
  }
  user(id: $id) {
    name
    profile {
      avatar {
        url
      }
      bio
    }
  }
}

$ graphql-document-utils query focus -s schema.graphql -q query.graphql User.email
exit: 0
stdout:
query GetUser($filter: SearchFilter) {
  search(filter: $filter) {
    ... on User {
      email
    }
  }
}

$ graphql-document-utils query strip -s schema.graphql -q query.graphql Profile
exit: 0
stdout:
query GetUser($id: ID!, $first: Int, $filter: SearchFilter) {
  user(id: $id) {
    name
  }
  company {
    employees(first: $first) {
      name
    }
  }
  search(filter: $filter) {
    __typename
    ... on User {
      email
    }
    ... on Company {
      name
    }
  }
}

$ graphql-document-utils query plan -s supergraph.graphql -q supergraph-query.graphql
exit: 0
stdout:
QueryPlan {
  Sequence {
    Fetch(service: "products") {
      {
        topProducts(first: 3) {
          __typename
          upc
          name
          weight
        }
      }
    },
    Flatten(path: "topProducts.@") {
      Fetch(service: "reviews") {
        {
          ... on Product {
            __typename
            upc
            weight
          }
        } =>
        {
          ... on Product {
            shipping
            reviews {
              body
              author {
                username
              }
            }
          }
        }
      },
    },
  },
}

$ graphql-document-utils schema prune -s schema.graphql -q query.graphql
exit: 0
stdout:
type Query {
  user(id: ID!): User
  company: Company
  search(filter: SearchFilter): [SearchResult]
}

type User {
  name: String
  email: String
  profile: Profile
}

type Profile {
  bio: String
  avatar: Avatar
}

type Avatar {
  url: String
}

type Company {
  name: String
  employees(first: Int): [User]
}

union SearchResult = User | Company

input SearchFilter {
  term: String
}

$ graphql-document-utils schema focus -s schema.graphql User
